<Window x:Class="Aether.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherWorkspace" Height="900" Width="1380"
        MinHeight="760" MinWidth="1120" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">

    <!-- Compact status strip -->
    <Border DockPanel.Dock="Top" Padding="10" Background="#FFF3F5F8" CornerRadius="6">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="AetherWorkspace" FontSize="17" FontWeight="Bold" Margin="0,0,18,0" />
          <TextBlock Text="Backend:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <TextBlock x:Name="BackendModeText" Text="connecting…" FontWeight="SemiBold" Margin="4,0,14,0"
                     AutomationProperties.AutomationId="BackendModeText" />
          <TextBlock Text="Classification:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <ComboBox x:Name="ClassificationCombo" Width="118" Margin="4,0,14,0"
                    AutomationProperties.AutomationId="ClassificationCombo"
                    AutomationProperties.Name="Data classification">
            <ComboBoxItem Content="UNKNOWN" />
            <ComboBoxItem Content="PUBLIC" />
            <ComboBoxItem Content="INTERNAL" />
            <ComboBoxItem Content="RESTRICTED" IsSelected="True" />
          </ComboBox>
          <CheckBox x:Name="CloudConsentCheck" Content="Cloud opt-in (consent)" VerticalAlignment="Center" Margin="0,0,14,0"
                    AutomationProperties.AutomationId="CloudConsent" />
          <TextBlock Text="Planner:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <ComboBox x:Name="PlannerCombo" Width="235" Margin="4,0,14,0"
                    AutomationProperties.AutomationId="PlannerCombo"
                    AutomationProperties.Name="Planning mode">
            <ComboBoxItem Content="Deterministic (offline)" IsSelected="True" />
            <ComboBoxItem Content="LLM-assisted (PUBLIC, consent)" />
          </ComboBox>
          <TextBlock Text="Selection:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <ComboBox x:Name="SelectionModeCombo" Width="110" Margin="4,0,0,0"
                    AutomationProperties.AutomationId="SelectionModeCombo"
                    AutomationProperties.Name="Launch selection mode">
            <ComboBoxItem Content="Preferred" IsSelected="True" />
            <ComboBoxItem Content="Strict" />
          </ComboBox>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DemoPresetButton" Content="WebView2 demo preset" Width="145" Margin="0,0,8,0"
                  Click="OnDemoPresetClick"
                  AutomationProperties.AutomationId="DemoPresetButton"
                  AutomationProperties.Name="Load WebView2 demo preset" />
          <Button x:Name="DemoLayoutButton" Content="Demo layout" Width="100" Margin="0,0,8,0"
                  Click="OnDemoLayoutClick"
                  AutomationProperties.AutomationId="DemoLayoutButton"
                  AutomationProperties.Name="Arrange demo layout" />
          <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="0,0,8,0" IsEnabled="False"
                  Click="OnCancelClick" AutomationProperties.AutomationId="CancelButton" />
          <Button x:Name="RunButton" Content="Run Instruction" Width="125" Click="OnRunClick"
                  AutomationProperties.AutomationId="RunButton" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status log -->
    <Border DockPanel.Dock="Bottom" Height="92" BorderBrush="#FFD0D4DA" BorderThickness="1"
            CornerRadius="4" Padding="8" Margin="0,10,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Status" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" FontFamily="Consolas" FontSize="11"
                 AutomationProperties.AutomationId="StatusBox"
                 AutomationProperties.Name="Workflow status" />
      </DockPanel>
    </Border>

    <!-- Execution details -->
    <Grid DockPanel.Dock="Bottom" Height="245" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Steps" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListView x:Name="StepsList" AutomationProperties.AutomationId="StepsList"
                    AutomationProperties.Name="Workflow steps">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="#" Width="32" DisplayMemberBinding="{Binding Index}" />
                <GridViewColumn Header="Action" Width="130" DisplayMemberBinding="{Binding Action}" />
                <GridViewColumn Header="State" Width="95" DisplayMemberBinding="{Binding State}" />
                <GridViewColumn Header="Code" Width="170" DisplayMemberBinding="{Binding Code}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock DockPanel.Dock="Top" x:Name="UiTelemetryText" FontSize="10" Foreground="#FF6B6B6B"
                     Margin="0,0,0,6" AutomationProperties.AutomationId="UiTelemetryText" />
          <TabControl>
            <TabItem Header="Summary">
              <TextBox x:Name="SummaryBox" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0"
                       AutomationProperties.AutomationId="SummaryBox"
                       AutomationProperties.Name="Private summary" />
            </TabItem>
            <TabItem Header="Plan preview">
              <TextBox x:Name="PlanPreviewBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0"
                       AutomationProperties.AutomationId="PlanPreviewBox"
                       AutomationProperties.Name="Validated plan preview" />
            </TabItem>
            <TabItem Header="Trace / audit">
              <TextBox x:Name="TraceBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0"
                       AutomationProperties.AutomationId="TraceBox"
                       AutomationProperties.Name="Trace and audit" />
            </TabItem>
            <TabItem Header="Inspector">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="ExportDiagnosticsButton" Content="Export diagnostics" Padding="10,3"
                          AutomationProperties.AutomationId="ExportDiagnosticsButton"
                          AutomationProperties.Name="Export diagnostics" Click="OnExportDiagnostics" />
                  <TextBlock x:Name="DiagnosticsStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="DiagnosticsStatusText" />
                </StackPanel>
                <ListView x:Name="InspectorList" BorderThickness="0"
                          AutomationProperties.AutomationId="InspectorList"
                          AutomationProperties.Name="Redacted trace timeline">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="#" Width="32" DisplayMemberBinding="{Binding Sequence}" />
                      <GridViewColumn Header="Action" Width="140" DisplayMemberBinding="{Binding Action}" />
                      <GridViewColumn Header="State" Width="100" DisplayMemberBinding="{Binding State}" />
                      <GridViewColumn Header="Code" Width="190" DisplayMemberBinding="{Binding Code}" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Command Center + applications -->
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="AI Command Center" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Instructions are untrusted proposals. The deterministic validator, capability authorizer and broker policy still decide what runs."
                       Foreground="#FF6B6B6B" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,8" />
            <DockPanel LastChildFill="True">
              <TextBlock Text="Template:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              <ComboBox x:Name="SavedInstructionsCombo" Width="290" Margin="4,0,10,0"
                        DisplayMemberPath="Title"
                        SelectionChanged="OnSavedInstructionChanged"
                        AutomationProperties.AutomationId="SavedInstructionsCombo"
                        AutomationProperties.Name="Saved instruction templates" />
              <TextBlock Text="Title:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              <TextBox x:Name="InstructionTitleBox" Margin="4,0,0,0" Height="26"
                       AutomationProperties.AutomationId="InstructionTitleBox"
                       AutomationProperties.Name="Instruction template title" />
            </DockPanel>
            <TextBlock Text="Instruction" Style="{StaticResource Caption}" Margin="0,8,0,2" />
            <TextBox x:Name="CommandBox" Height="78" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="CommandBox"
                     AutomationProperties.Name="Workflow instruction"
                     Text="Open Northstar bond analytics, show the associated risk view, synchronize this instrument across the workspace and summarize the exposure privately." />
            <DockPanel Margin="0,8,0,0" LastChildFill="True">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="NewInstructionButton" Content="New" Width="72" Margin="0,0,6,0" Click="OnNewInstructionClick"
                        AutomationProperties.AutomationId="NewInstructionButton" />
                <Button x:Name="SaveInstructionButton" Content="Save" Width="72" Margin="0,0,6,0" Click="OnSaveInstructionClick"
                        AutomationProperties.AutomationId="SaveInstructionButton" />
                <Button x:Name="DuplicateInstructionButton" Content="Duplicate" Width="82" Margin="0,0,6,0" Click="OnDuplicateInstructionClick"
                        AutomationProperties.AutomationId="DuplicateInstructionButton" />
                <Button x:Name="DeleteInstructionButton" Content="Delete" Width="72" Click="OnDeleteInstructionClick"
                        AutomationProperties.AutomationId="DeleteInstructionButton" />
              </StackPanel>
              <TextBlock x:Name="PhaseText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="IDLE" FontWeight="SemiBold" Foreground="#FF2D6CDF"
                         AutomationProperties.AutomationId="PhaseText" />
            </DockPanel>
          </StackPanel>
          <Grid Margin="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="PlanPreviewLabel" Text="Validated plan preview appears after a genuine plan exists."
                         FontSize="11" Foreground="#FF6B6B6B" />
              <TextBlock x:Name="HintText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF6B6B6B" FontSize="11"
                         Text="Run Instruction performs classification → planning → validation → authorization → execution. Saved templates are revalidated on every run." />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Applications" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="Refresh" Width="70" Margin="10,0,0,0" Click="OnRefreshAppsClick"
                      AutomationProperties.AutomationId="RefreshAppsButton" />
            </StackPanel>
            <Button Content="Launch Selected" Width="125" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Click="OnLaunchSelectedClick"
                    AutomationProperties.AutomationId="LaunchSelectedButton" />
          </DockPanel>
          <DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    SelectionMode="Single" RowHeight="30" FontSize="11"
                    AutomationProperties.AutomationId="AppsGrid"
                    AutomationProperties.Name="Registered applications">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay}" Width="28" />
              <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeType}" Width="72" IsReadOnly="True" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="72" IsReadOnly="True" />
              <DataGridTemplateColumn Header="Actions" Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Launch" Tag="{Binding}" Click="OnLaunchAppClick" Padding="5,1" Margin="0,0,4,0"
                              AutomationProperties.AutomationId="LaunchAppButton" />
                      <Button Content="Focus" Tag="{Binding}" Click="OnFocusAppClick" Padding="5,1" Margin="0,0,4,0"
                              AutomationProperties.AutomationId="FocusAppButton" />
                      <Button Content="Stop" Tag="{Binding}" Click="OnStopAppClick" Padding="5,1" Margin="0,0,4,0"
                              AutomationProperties.AutomationId="StopAppButton" />
                      <Button Content="Restart" Tag="{Binding}" Click="OnRestartAppClick" Padding="5,1"
                              AutomationProperties.AutomationId="RestartAppButton" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
