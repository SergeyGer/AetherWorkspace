<Window x:Class="Aether.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherWorkspace" Height="760" Width="1120"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Padding="12" Background="#FFF3F5F8" CornerRadius="6">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Backend:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock x:Name="BackendModeText" Text="connecting…" FontWeight="SemiBold" Margin="4,0,16,0"
                       AutomationProperties.AutomationId="BackendModeText" />
            <TextBlock Text="Classification:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <ComboBox x:Name="ClassificationCombo" Width="130" Margin="4,0,16,0"
                      AutomationProperties.AutomationId="ClassificationCombo"
                      AutomationProperties.Name="Data classification">
              <ComboBoxItem Content="UNKNOWN" />
              <ComboBoxItem Content="PUBLIC" />
              <ComboBoxItem Content="INTERNAL" />
              <ComboBoxItem Content="RESTRICTED" IsSelected="True" />
            </ComboBox>
            <CheckBox x:Name="CloudConsentCheck" Content="Cloud opt-in (consent)" VerticalAlignment="Center" Margin="0,0,16,0"
                      AutomationProperties.AutomationId="CloudConsent" />
            <TextBlock Text="Planner:" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <ComboBox x:Name="PlannerCombo" Width="170" Margin="4,0,16,0"
                      AutomationProperties.AutomationId="PlannerCombo"
                      AutomationProperties.Name="Planning mode">
              <ComboBoxItem Content="Deterministic (offline)" IsSelected="True" />
              <ComboBoxItem Content="LLM-assisted (PUBLIC, consent)" />
            </ComboBox>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DemoLayoutButton" Content="Demo layout" Width="110" Margin="0,0,8,0" Click="OnDemoLayoutClick"
                    AutomationProperties.AutomationId="DemoLayoutButton"
                    AutomationProperties.Name="Arrange demo layout" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" IsEnabled="False" Click="OnCancelClick"
                    AutomationProperties.AutomationId="CancelButton" />
            <Button x:Name="RunButton" Content="Run workflow" Width="130" Click="OnRunClick"
                    AutomationProperties.AutomationId="RunButton" />
          </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,10,0,0" LastChildFill="True">
          <TextBox x:Name="CommandBox" DockPanel.Dock="Left" Width="760" Height="46"
                   TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                   AutomationProperties.AutomationId="CommandBox"
                   AutomationProperties.Name="Workflow command"
                   Text="Open Northstar bond analytics, show the associated risk view, synchronize this instrument across the workspace and summarize the exposure privately." />
          <TextBlock x:Name="HintText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                     TextWrapping="Wrap" Foreground="#FF6B6B6B" FontSize="11"
                     Text="Deterministic planning is the default. No model call is made unless a cloud adapter is configured and explicitly consented." />
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Bottom" Height="230" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Steps" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListView x:Name="StepsList"
                    AutomationProperties.AutomationId="StepsList"
                    AutomationProperties.Name="Workflow steps">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Index}" />
                <GridViewColumn Header="Action" Width="140" DisplayMemberBinding="{Binding Action}" />
                <GridViewColumn Header="State" Width="100" DisplayMemberBinding="{Binding State}" />
                <GridViewColumn Header="Code" Width="180" DisplayMemberBinding="{Binding Code}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TabControl>
            <TabItem Header="Summary">
              <TextBox x:Name="SummaryBox" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0"
                       AutomationProperties.AutomationId="SummaryBox"
                       AutomationProperties.Name="Private summary" />
            </TabItem>
            <TabItem Header="Trace / audit">
              <TextBox x:Name="TraceBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0"
                       AutomationProperties.AutomationId="TraceBox"
                       AutomationProperties.Name="Trace and audit" />
            </TabItem>
            <TabItem Header="Inspector">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="ExportDiagnosticsButton" Content="Export diagnostics" Padding="10,3"
                          AutomationProperties.AutomationId="ExportDiagnosticsButton"
                          AutomationProperties.Name="Export diagnostics"
                          Click="OnExportDiagnostics" />
                  <TextBlock x:Name="DiagnosticsStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="DiagnosticsStatusText" />
                </StackPanel>
                <ListView x:Name="InspectorList" BorderThickness="0"
                          AutomationProperties.AutomationId="InspectorList"
                          AutomationProperties.Name="Redacted trace timeline">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Sequence}" />
                      <GridViewColumn Header="Action" Width="150" DisplayMemberBinding="{Binding Action}" />
                      <GridViewColumn Header="State" Width="120" DisplayMemberBinding="{Binding State}" />
                      <GridViewColumn Header="Code" Width="200" DisplayMemberBinding="{Binding Code}" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>

    <Border BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Status" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" FontFamily="Consolas"
                 AutomationProperties.AutomationId="StatusBox"
                 AutomationProperties.Name="Workflow status" />
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
