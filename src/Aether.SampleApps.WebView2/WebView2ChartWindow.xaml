<Window x:Class="Aether.SampleApps.WebView2.WebView2ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Synthetic Bond Chart (WebView2)" Height="620" Width="1020">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Synthetic Bond Chart — WebView2 host" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="Independent WebView2 process; local JS renderer; typed context arrives only through the .NET host."
                 FontSize="11" Foreground="#FF6B6B6B" />
      <TextBlock x:Name="ProcessBadgeText" Margin="0,4,0,0" FontSize="10" Foreground="#FF6B6B6B"
                 AutomationProperties.AutomationId="WebView2ChartProcessBadge" />
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11" Text="Connecting to local broker…"
                 AutomationProperties.AutomationId="WebView2ChartStatus" />
      <TextBlock x:Name="BridgeStatusText" Margin="0,2,0,0" FontSize="11" Foreground="#FF44505C"
                 Text="JS bridge starting…" AutomationProperties.AutomationId="WebView2BridgeStatus" />
      <TextBlock x:Name="FallbackText" Margin="0,2,0,0" FontSize="11" Foreground="#FFB23A3A"
                 Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="WebView2FallbackStatus" />
    </StackPanel>
    <Border Margin="0,10,0,0" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="4" Background="#FFFBFCFD">
      <wv2:WebView2 x:Name="WebView2Surface" AutomationProperties.AutomationId="WebView2ChartSurface" />
    </Border>
  </DockPanel>
</Window>
