<Window x:Class="Aether.SampleApps.WatchlistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synthetic Watchlist" Height="520" Width="860">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Synthetic Watchlist" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="Fixture data only — no live market connectivity, no customer records." FontSize="11" Foreground="#FF6B6B6B" />
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11" Text="Connecting to local broker…" />
    </StackPanel>
    <DataGrid x:Name="Grid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}" Width="90" />
        <DataGridTextColumn Header="Instrument" Binding="{Binding Name}" Width="220" />
        <DataGridTextColumn Header="Issuer (fictitious)" Binding="{Binding Issuer}" Width="240" />
        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="80" />
        <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
