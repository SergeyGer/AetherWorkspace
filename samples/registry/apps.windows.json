{
  "manifestVersion": "1.0",
  "apps": [
    {
      "appId": "sample.watchlist",
      "displayName": "Synthetic Watchlist (WPF)",
      "launchable": true,
      "executable": "{WPF_SAMPLES_EXE}",
      "arguments": [
        "--app",
        "watchlist",
        "--fixtures",
        "{FIXTURES_DIR}"
      ],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": [
        "context.subscribe",
        "context.publish",
        "window.report"
      ],
      "allowedChannels": [
        "default"
      ],
      "allowedContextTypes": [
        "fdc3.instrument",
        "fdc3.organization"
      ],
      "allowedClassifications": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ],
      "maxInstances": 1,
      "launchTimeoutSeconds": 60,
      "intents": [
        "ViewInstrument"
      ]
    },
    {
      "appId": "sample.risk",
      "displayName": "Synthetic Risk View (WPF)",
      "launchable": true,
      "executable": "{WPF_SAMPLES_EXE}",
      "arguments": [
        "--app",
        "risk",
        "--fixtures",
        "{FIXTURES_DIR}"
      ],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": [
        "context.subscribe",
        "context.publish",
        "window.report"
      ],
      "allowedChannels": [
        "default"
      ],
      "allowedContextTypes": [
        "fdc3.instrument",
        "fdc3.organization"
      ],
      "allowedClassifications": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ],
      "maxInstances": 1,
      "launchTimeoutSeconds": 60,
      "intents": [
        "ViewAnalysis"
      ]
    },
    {
      "appId": "sample.chart",
      "displayName": "Synthetic Bond Chart (WPF)",
      "launchable": true,
      "executable": "{WPF_SAMPLES_EXE}",
      "arguments": [
        "--app",
        "chart",
        "--fixtures",
        "{FIXTURES_DIR}"
      ],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": [
        "context.subscribe",
        "context.publish",
        "window.report"
      ],
      "allowedChannels": [
        "default"
      ],
      "allowedContextTypes": [
        "fdc3.instrument",
        "fdc3.organization"
      ],
      "allowedClassifications": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ],
      "maxInstances": 1,
      "launchTimeoutSeconds": 60,
      "intents": [
        "ViewChart"
      ]
    },
    {
      "appId": "sample.chart.webview2",
      "displayName": "Synthetic Bond Chart (WebView2)",
      "launchable": true,
      "executable": "{WEBVIEW2_CHART_EXE}",
      "arguments": [
        "--app",
        "webview2-chart",
        "--fixtures",
        "{FIXTURES_DIR}"
      ],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": [
        "context.subscribe",
        "context.publish",
        "window.report"
      ],
      "allowedChannels": [
        "default"
      ],
      "allowedContextTypes": [
        "fdc3.instrument"
      ],
      "allowedClassifications": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ],
      "maxInstances": 1,
      "launchTimeoutSeconds": 60,
      "intents": [
        "ViewChart"
      ]
    },
    {
      "appId": "aether.shell",
      "displayName": "Aether Workspace Shell",
      "launchable": false,
      "executable": "",
      "arguments": [],
      "capabilities": [
        "plan.execute",
        "broker.launch",
        "broker.arrange",
        "context.publish",
        "context.read",
        "window.report",
        "intent.resolve",
        "workspace.layout.save",
        "workspace.layout.restore"
      ],
      "allowedChannels": [
        "default"
      ],
      "allowedContextTypes": [
        "fdc3.instrument",
        "aether.exposure",
        "fdc3.organization"
      ],
      "allowedClassifications": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ],
      "maxInstances": 1
    }
  ]
}
