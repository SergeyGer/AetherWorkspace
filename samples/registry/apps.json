{
  "manifestVersion": "1.0",
  "apps": [
    {
      "appId": "sample.watchlist",
      "displayName": "Synthetic Watchlist",
      "launchable": true,
      "executable": "{DOTNET}",
      "arguments": ["{SAMPLES_DLL}", "--app", "watchlist", "--fixtures", "{FIXTURES_DIR}"],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": ["context.subscribe", "context.publish", "window.report"],
      "allowedChannels": ["default"],
      "allowedContextTypes": ["fdc3.instrument"],
      "allowedClassifications": ["PUBLIC", "INTERNAL", "RESTRICTED"],
      "maxInstances": 1,
      "launchTimeoutSeconds": 20
    },
    {
      "appId": "sample.risk",
      "displayName": "Synthetic Risk View",
      "launchable": true,
      "executable": "{DOTNET}",
      "arguments": ["{SAMPLES_DLL}", "--app", "risk", "--fixtures", "{FIXTURES_DIR}"],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": ["context.subscribe", "context.publish", "window.report"],
      "allowedChannels": ["default"],
      "allowedContextTypes": ["fdc3.instrument"],
      "allowedClassifications": ["PUBLIC", "INTERNAL", "RESTRICTED"],
      "maxInstances": 1,
      "launchTimeoutSeconds": 20
    },
    {
      "appId": "sample.chart",
      "displayName": "Synthetic Bond Chart",
      "launchable": true,
      "executable": "{DOTNET}",
      "arguments": ["{SAMPLES_DLL}", "--app", "chart", "--fixtures", "{FIXTURES_DIR}"],
      "workingDirectory": "{AETHER_HOME}",
      "capabilities": ["context.subscribe", "context.publish", "window.report"],
      "allowedChannels": ["default"],
      "allowedContextTypes": ["fdc3.instrument"],
      "allowedClassifications": ["PUBLIC", "INTERNAL", "RESTRICTED"],
      "maxInstances": 1,
      "launchTimeoutSeconds": 20
    },
    {
      "appId": "aether.shell",
      "displayName": "Aether Workspace Shell",
      "launchable": false,
      "executable": "",
      "arguments": [],
      "capabilities": [
        "plan.execute",
        "broker.launch",
        "broker.arrange",
        "context.publish",
        "context.read",
        "window.report"
      ],
      "allowedChannels": ["default"],
      "allowedContextTypes": ["fdc3.instrument", "aether.exposure"],
      "allowedClassifications": ["PUBLIC", "INTERNAL", "RESTRICTED"],
      "maxInstances": 1
    }
  ]
}
