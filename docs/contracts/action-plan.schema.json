{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherworkspace.example/schemas/action-plan.schema.json",
  "title": "AetherWorkspace ActionPlan v1",
  "description": "Versioned, untrusted plan proposal. Steps are flat and typed; executable paths, URLs and shell commands are not part of the schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "steps"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.", "description": "SemVer schema version; major version 1 is supported." },
    "planId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "description": { "type": "string", "maxLength": 512 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["LaunchApp", "PublishContext", "ArrangeWindows", "SummarizeContext", "ShowStatus"] },
        "appId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "contextRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "layout": { "enum": ["side-by-side"] },
        "mode": { "enum": ["private"] },
        "statusText": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "LaunchApp" } } }, "then": { "required": ["appId"], "not": { "anyOf": [ { "required": ["contextRef"] }, { "required": ["layout"] }, { "required": ["mode"] }, { "required": ["statusText"] } ] } } },
        { "if": { "properties": { "action": { "const": "PublishContext" } } }, "then": { "required": ["contextRef"], "not": { "anyOf": [ { "required": ["appId"] }, { "required": ["layout"] }, { "required": ["mode"] }, { "required": ["statusText"] } ] } } },
        { "if": { "properties": { "action": { "const": "ArrangeWindows" } } }, "then": { "required": ["layout"], "not": { "anyOf": [ { "required": ["appId"] }, { "required": ["contextRef"] }, { "required": ["mode"] }, { "required": ["statusText"] } ] } } },
        { "if": { "properties": { "action": { "const": "SummarizeContext" } } }, "then": { "required": ["contextRef"], "not": { "anyOf": [ { "required": ["appId"] }, { "required": ["layout"] }, { "required": ["statusText"] } ] } } },
        { "if": { "properties": { "action": { "const": "ShowStatus" } } }, "then": { "required": ["statusText"], "not": { "anyOf": [ { "required": ["appId"] }, { "required": ["contextRef"] }, { "required": ["layout"] }, { "required": ["mode"] } ] } } }
      ]
    }
  }
}
