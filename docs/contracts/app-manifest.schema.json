{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherworkspace.example/schemas/app-manifest.schema.json",
  "title": "AetherWorkspace app manifest v1",
  "description": "Allowlisted applications the broker may launch. Only trusted local configuration; plans reference app ids only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "apps"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "pattern": "^1\\."
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "displayName",
        "capabilities",
        "allowedChannels",
        "allowedContextTypes",
        "allowedClassifications"
      ],
      "properties": {
        "appId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "launchable": {
          "type": "boolean",
          "default": true
        },
        "executable": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "workingDirectory": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "context.publish",
              "context.subscribe",
              "context.read",
              "window.report",
              "broker.launch",
              "broker.arrange",
              "plan.execute",
              "intent.resolve"
            ]
          },
          "uniqueItems": true
        },
        "allowedChannels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "allowedContextTypes": {
          "type": "array",
          "items": {
            "enum": [
              "fdc3.instrument",
              "fdc3.organization",
              "aether.exposure"
            ]
          }
        },
        "allowedClassifications": {
          "type": "array",
          "items": {
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "RESTRICTED",
              "UNKNOWN"
            ]
          }
        },
        "maxInstances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        },
        "launchTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 15
        },
        "intents": {
          "type": "array",
          "items": {
            "enum": [
              "ViewInstrument",
              "ViewAnalysis",
              "ViewChart"
            ]
          },
          "uniqueItems": true,
          "description": "Declared bounded FDC3 intents handled by the app."
        }
      }
    }
  }
}
