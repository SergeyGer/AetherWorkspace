# AetherWorkspace local environment template (v0.4 model providers).
#
# Copy this file to `.env` and fill in your own credentials locally.
# `.env` is git-ignored and MUST NOT be committed or shared.
# The shell loads it explicitly with: --env-file .env
# Values are read through ISecretProvider and are never written to audit/logs/telemetry.
#
# Cloud use remains OFF by default and requires explicit consent + an allowed data
# classification (PUBLIC opt-in; INTERNAL denied by default; RESTRICTED/UNKNOWN hard deny).

# ---------------------------------------------------------------------------
# Cloud provider selection (v0.4 router): openai | gemini | local | deterministic
# ---------------------------------------------------------------------------
AETHER_MODEL_PROVIDER=openai

# ---------------------------------------------------------------------------
# OpenAI-compatible adapter
#   OPENAI_BASE_URL can point at api.openai.com or an OpenAI-compatible gateway.
#   Model identifiers are configuration, never hardcoded in business logic.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini  # cost-optimized default; re-check current pricing/model IDs before v0.4 runs

# Generic cloud adapter variables used by the current HttpCloudModelTransport
# (keep in sync with OPENAI_* if you use the generic adapter):
AETHER_CLOUD_ENDPOINT=https://api.openai.com/v1/chat/completions
AETHER_CLOUD_MODEL=gpt-4o-mini  # generic adapter default (same cost-optimized choice)
AETHER_CLOUD_API_KEY=replace-with-provider-key

# ---------------------------------------------------------------------------
# Google Gemini adapter (v0.4; not implemented end-to-end yet)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite  # cheapest available Gemini tier (2.5-flash-lite is closed to new users)
# Note: gemini-2.5-flash/pro IDs are being deprecated during late 2026; flash-lite remains
# the cheapest paid option. Verify model IDs and prices before running v0.4 evaluations.

# ---------------------------------------------------------------------------
# Local model adapter (loopback, private/offline path)
#   The project never assumes a loopback endpoint is air-gapped; verify it.
#   A missing local model yields a safe error or the deterministic local summary,
#   never an unauthorized cloud fallback.
# ---------------------------------------------------------------------------
AETHER_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
AETHER_LOCAL_MODEL=qwen2.5:3b  # small local model for cost-free offline runs (Ollama tag)

# ---------------------------------------------------------------------------
# Evaluation harness (v0.4) - optional paths for reproducible model studies
# ---------------------------------------------------------------------------
AETHER_EVAL_RESULTS=.aether/evaluation
